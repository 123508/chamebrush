{
  "name": "@chamebrush/browser",
  "version": "0.1.0",
  "private": false,
  "description": "Browser API and SVG, PNG and WebP export for Chamebrush",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chamebrush",
    "browser",
    "svg",
    "png",
    "webp"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chamebrush/core": "workspace:^",
    "@chamebrush/renderer-svg": "workspace:^"
  }
}
